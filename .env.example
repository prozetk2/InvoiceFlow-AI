# Copy to .env (ignored by Git). Generate API key: python -c 'import secrets; print(secrets.token_urlsafe(32))'
INVOICEFLOW_API_KEY=REPLACE_WITH_A_NEW_RANDOM_32_BYTE_SECRET
# Optional second key. When set, only this key can approve and it cannot import/review,
# so review and approval need two different credentials. Must differ from the key above.
# INVOICEFLOW_APPROVER_API_KEY=REPLACE_WITH_ANOTHER_RANDOM_SECRET
INVOICEFLOW_DB_PATH=data/invoiceflow.sqlite3
INVOICEFLOW_API_URL=http://127.0.0.1:8000

# Off by default. Upload endpoint returns 503 unless enabled.
INVOICEFLOW_ENABLE_OCR_UPLOAD=false
INVOICEFLOW_OCR_LANG=vi
INVOICEFLOW_OCR_DEVICE=cpu
# Optional; check lang/model support before changing
# INVOICEFLOW_OCR_VERSION=PP-OCRv6

# External LLM is opt-in only from explicit CLI/controlled workflow.
# API upload does NOT call external LLM.
# GEMINI_API_KEY=YOUR_SECRET_IN_LOCAL_ENV_ONLY
GEMINI_MODEL=gemini-flash-latest
# Keep uploaded source images as review evidence (local SQLite, unencrypted). false = store none.
INVOICEFLOW_STORE_IMAGES=true
